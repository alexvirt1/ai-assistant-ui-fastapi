# --- Model / server ---
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://192.168.87.160:11434
# qwen3:8b needs about 6.7 GB at 24576 and 7.3 GB at 32768. Both fit a free
# 12 GB GPU; 24576 leaves more room next to ComfyUI. Check `ollama ps` shows
# 100% GPU: a model loaded while the GPU was busy stays partly on the CPU.
OLLAMA_NUM_CTX=24576
# How long the VM keeps a model in memory. Ollama's own default is 5m, which
# makes an idle conversation re-pay the cold load (~6s for an 8B, ~19s for a
# 14B) on its next turn.
#OLLAMA_KEEP_ALIVE=30m
# Model roles (see models.example.yaml); OLLAMA_MODEL still wins for "fast".
#MODELS_CONFIG=models.yaml
# Token budget for conversation history sent to the model, excluding the system
# prompt and tool schemas. Keep well under OLLAMA_NUM_CTX; defaults to a third
# of it, so the two scale together.
#HISTORY_MAX_TOKENS=12000
# Enables per-thread conversation persistence when set
#DATABASE_URL=postgresql://user:password@localhost:5432/agentlab

# --- Image generation (text-to-image on ComfyUI) ---
# Enables the generate_image tool when set. ComfyUI on AI-1 shares its GPU with
# Ollama: the chat model is unloaded while an image is generated.
#COMFYUI_BASE_URL=http://192.168.87.160:8188
# z-image-turbo (default, fast) or flux2-klein
#IMAGE_MODEL=z-image-turbo
# Give up (and cancel the job) after this many seconds.
#IMAGE_TIMEOUT_SECONDS=180
# Free VRAM to wait for after images before reloading the chat model (bytes).
#IMAGE_HANDBACK_FREE_BYTES=8500000000

# --- Identity ---
# There is no login: every request is attributed to this one user, and chats
# are scoped to it. Defaults to "alice". Change it to verify that scoping
# works - the chat list comes back empty under a different value, and another
# user's thread id is refused rather than resumed.
#SINGLE_USER_ID=alice

# --- Tools ---
# Comma-separated allowlist of tool names; empty/unset = all available tools
#ENABLED_TOOLS=current_time,fetch_page

# web_search (enabled when a provider key is set; SEARCH_PROVIDER=serpapi|brave to force one)
#SERPAPI_API_KEY=
#BRAVE_API_KEY=
#SEARCH_PROVIDER=

# --- Hybrid mode: hand a turn over to a cloud model (cloud_models.yaml) ---
# Turns it on. A Claude API key from console.anthropic.com (billed per token,
# separately from a claude.ai subscription); set a spend limit there too.
#ANTHROPIC_API_KEY=
# App-side monthly limit in USD; over it, turns are answered locally.
#CLOUD_BUDGET_USD=10
# Which entry of cloud_models.yaml to use (default: the first with a key).
#CLOUD_MODEL=claude-sonnet
# History sent to the cloud model per turn, in tokens.
#CLOUD_HISTORY_MAX_TOKENS=8000

# ask_openai delegate tool
#OPENAI_API_KEY=
#OPENAI_DELEGATE_MODEL=gpt-4o-mini

# Declarative REST tools (see rest_tools.example.yaml)
#REST_TOOLS_CONFIG=rest_tools.yaml

# RapidAPI key for the Yahoo Finance entries in rest_tools.yaml
# (get_stock_quote / get_stock_history). Those tools stay disabled until set.
#RAPIDAPI_KEY=

# MCP servers (see mcp_servers.example.yaml)
#MCP_SERVERS_CONFIG=mcp_servers.yaml
