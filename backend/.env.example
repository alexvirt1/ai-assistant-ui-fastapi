# --- Model / server ---
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://192.168.87.160:11434
OLLAMA_NUM_CTX=8192
# How long the VM keeps a model in memory. Ollama's own default is 5m, which
# makes an idle conversation re-pay the cold load (~6s for an 8B, ~19s for a
# 14B) on its next turn.
#OLLAMA_KEEP_ALIVE=30m
# Model roles (see models.example.yaml); OLLAMA_MODEL still wins for "fast".
#MODELS_CONFIG=models.yaml
# Token budget for conversation history sent to the model, excluding the system
# prompt and tool schemas. Keep well under OLLAMA_NUM_CTX. Default 3000.
#HISTORY_MAX_TOKENS=3000
# Enables per-thread conversation persistence when set
#DATABASE_URL=postgresql://user:password@localhost:5432/agentlab

# --- Tools ---
# Comma-separated allowlist of tool names; empty/unset = all available tools
#ENABLED_TOOLS=current_time,fetch_page

# web_search (enabled when a provider key is set; SEARCH_PROVIDER=serpapi|brave to force one)
#SERPAPI_API_KEY=
#BRAVE_API_KEY=
#SEARCH_PROVIDER=

# ask_openai / ask_claude delegate tools
#OPENAI_API_KEY=
#OPENAI_DELEGATE_MODEL=gpt-4o-mini
#ANTHROPIC_API_KEY=
#CLAUDE_DELEGATE_MODEL=claude-opus-5

# Declarative REST tools (see rest_tools.example.yaml)
#REST_TOOLS_CONFIG=rest_tools.yaml

# RapidAPI key for the Yahoo Finance entries in rest_tools.yaml
# (get_stock_quote / get_stock_history). Those tools stay disabled until set.
#RAPIDAPI_KEY=

# MCP servers (see mcp_servers.example.yaml)
#MCP_SERVERS_CONFIG=mcp_servers.yaml
