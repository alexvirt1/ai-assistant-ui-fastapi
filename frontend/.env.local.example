# Frontend runtime configuration. Copy to .env.local (which is gitignored).
#
# These are read on the server in app/page.tsx and passed to the client, not
# exposed as NEXT_PUBLIC_* — so changing them takes effect on a frontend
# restart, with no rebuild:
#
#   sudo systemctl restart assistant-ui-frontend

# Characters kept from a single attachment; the rest is truncated with a marker.
# Roughly 4 characters per token, so 24000 is about 6000 tokens.
#
# The practical ceiling is the backend's HISTORY_MAX_TOKENS (default: a third of
# OLLAMA_NUM_CTX). Setting this beyond that budget does not fail — the backend's
# trimmer simply discards the attachment sooner, which looks like the model
# ignoring the document. Raise HISTORY_MAX_TOKENS and OLLAMA_NUM_CTX together
# when experimenting with large files.
MAX_ATTACHMENT_CHARS=24000

# Files larger than this are refused before being read into the browser.
MAX_ATTACHMENT_BYTES=1000000
